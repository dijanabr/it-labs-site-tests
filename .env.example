# Copy to .env to override defaults.

# Site under test. Defaults to production; point it at staging to validate a release before it goes live.
BASE_URL=https://www.it-labs.com

# Real contact-form submissions (@submit tests). Off unless exactly "true": they send real messages.
RUN_SUBMIT=false
# Inbox that receives the "QA TEST - please ignore" messages.
QA_EMAIL=

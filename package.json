{
  "name": "it-labs-regression",
  "version": "1.0.0",
  "description": "Playwright regression suite for https://www.it-labs.com (functional, visual, responsive, console, SEO, consent/tracking).",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=desktop-chrome --project=mobile-chrome --project=mobile-safari --project=tablet",
    "test:smoke": "playwright test --project=desktop-chrome tests/smoke",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:responsive": "playwright test --project=mobile-chrome --project=mobile-safari --project=tablet",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=desktop-chrome --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}

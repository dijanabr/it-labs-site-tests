{
  "name": "it-labs-regression",
  "version": "1.0.0",
  "description": "Playwright regression suite for https://www.it-labs.com (functional, cross-browser, visual, responsive, accessibility, security headers, console, SEO, consent/tracking).",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=desktop-chrome --project=desktop-firefox --project=desktop-webkit --project=mobile-chrome --project=mobile-safari --project=tablet",
    "test:smoke": "playwright test --project=desktop-chrome tests/smoke",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:cross-browser": "playwright test --project=desktop-firefox --project=desktop-webkit",
    "test:responsive": "playwright test --project=mobile-chrome --project=mobile-safari --project=tablet",
    "test:a11y": "playwright test tests/accessibility --project=desktop-chrome --project=tablet",
    "test:security": "playwright test tests/security --project=desktop-chrome",
    "test:submit": "playwright test --grep @submit --project=desktop-chrome",
    "test:visual": "playwright test --project=visual-desktop --project=visual-firefox --project=visual-webkit --project=visual-mobile --project=visual-tablet",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-firefox --project=visual-webkit --project=visual-mobile --project=visual-tablet --update-snapshots",
    "test:all": "playwright test",
    "test:headed": "playwright test --project=desktop-chrome --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
